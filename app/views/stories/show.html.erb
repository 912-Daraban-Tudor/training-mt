<p style="color: green"><%= notice %></p>

<%= render partial: "stories/story", locals: { story: @story } %>

<div>
  <%= link_to "Edit this story", edit_story_path(@story) %> |
  <%= link_to "Back to stories", stories_path %>

  <%= button_to "Destroy this story", story_path(@story), method: :delete %>

</div>
