<div id="<%= dom_id story %>">
  <p>
    <strong>Title:</strong>
    <%= story.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= story.description %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= story.status %>
  </p>

  <p>
    <strong>Due date:</strong>
    <%= story.due_date %>
  </p>

  <p>
    <strong>Position:</strong>
    <%= story.position %>
  </p>

  <p>
    <strong>Board:</strong>
    <%= story.board_id %>
  </p>

</div>
