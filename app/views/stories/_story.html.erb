<div id="<%= dom_id story %>">
  <p>
    <strong>Type:</strong>
    <%= story.type&.split('::')&.last || 'Unknown' %>
  </p>

  <p>
    <strong>Assigned To:</strong>
    <% if story.associable %>
      <%= story.associable_type %>: <strong><%= story.associable.name %></strong>
    <% else %>
      <em>Unassigned</em>
    <% end %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= story.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= story.description %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= story.status %>
  </p>

  <p>
    <strong>Due date:</strong>
    <%= story.due_date %>
  </p>

  <p>
    <strong>Position:</strong>
    <%= story.position %>
  </p>

  <%= link_to "Edit this story", edit_story_path(story) %> |
</div>