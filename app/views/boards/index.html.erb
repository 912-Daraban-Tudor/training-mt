<p style="color: green"><%= notice %></p>

<% content_for :title, "Boards" %>

<h1>Boards</h1>

<div id="boards" style="display: grid">
  <% if  policy(Board).index? %>
    <% @boards.each do |board| %>
      <%= render board %>
    <% end %>
  <% else %>
    You are not authorized
  <% end %>

</div>

<%= link_to "New board", new_board_path %>

