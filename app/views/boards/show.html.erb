<p style="color: green"><%= notice %></p>

<div style="display: flex;">
  <h1><%= @board.name %> - </h1>

  <div style="padding: 35px 20px 20px 15px">
    <%= link_to "Edit Board", edit_board_path(@board) %> |
    <%= link_to "Back to Boards", boards_path %>
  </div>
</div>

<div style="display: flex; flex-direction: row; justify-content: space-around ">
  <% @ordered_columns.each do |column| %>

    <div style="border: solid; border-color: #2E2F30; padding: 20px 20px 20px 20px; margin: 3px 3px 3px 3px; scroll-behavior: auto; min-width: 15%; max-width: 23%">
      <h3>
        <%= column.name %>
      </h3>



      <% column.stories(@board).each do |story| %>

        <div style=" margin: 2px 1px 2px 1px; border: solid; border-width: thin; border-color: #730E15; padding: 5px 5px 5px 5px">
          <strong><%= story.title %></strong>

          <p>
            <%= story.description %>
          </p>

          <p>
            <%= story.status %>
          </p>

          <div>
            <%= link_to "Edit", edit_story_path(story) %> |
            <%= link_to "Delete", story, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </div>
        </div>

      <% end %>

      <div>
        <%= link_to "+ Add Story", new_story_path(board_id: @board.id)%>
      </div>

    </div>
  <% end %>
</div>