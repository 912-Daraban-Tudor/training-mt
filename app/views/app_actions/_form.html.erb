<%= form_with(model: app_action) do |form| %>
  <% if app_action.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(app_action.errors.count, "error") %> prohibited this app_action from being saved:</h2>

      <ul>
        <% app_action.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
