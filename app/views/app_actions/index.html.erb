<p style="color: green"><%= notice %></p>

<% content_for :title, "App actions" %>

<h1>App actions</h1>

<div id="app_actions">
  <% @app_actions.each do |app_action| %>
    <%= render app_action %>
    <p>
      <%= link_to "Show this app action", app_action %>
    </p>
  <% end %>
</div>

<%= link_to "New app action", new_app_action_path %>
