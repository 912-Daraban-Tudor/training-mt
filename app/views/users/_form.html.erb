<%= form_with(model: user) do |form| %>
  <% if user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p><strong>Edit roles for:</strong> <%= user.name %></p>

  <div>
    <h3>Select Your Roles:</h3>
    <%= form.collection_check_boxes :role_ids, Role.where.not(name: 'Admin'), :id, :name do |b| %>
      <div style="margin-bottom: 5px;">
        <%= b.check_box %>
        <%= b.label %>
      </div>
    <% end %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
